{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.2",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(?:banco_de_dados\\.sql|composer\\.(?:json|lock)|Instruções\\.txt|pedido\\.lock|deploy\\.php)",
      "status": 404
    },
    {
      "src": "/.*\\.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/uploads/.*",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/api/index.php"
    }
  ]
}
